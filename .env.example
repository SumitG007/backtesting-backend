PORT=3001
# PORT=9877
CORS_ORIGIN=http://69.62.85.199,http://localhost:5173,http://127.0.0.1:5173

# Login email/password live in MongoDB (PlatformAdmin) — not synced from env.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Dhan — seed once via POST /api/dhan/access-token; auto-renew ~every 20h while server runs
DHAN_CLIENT_ID=
DHAN_TOKEN_REFRESH_INTERVAL_MS=72000000
DHAN_TOKEN_RENEW_ON_STARTUP=true

MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/backtesting?retryWrites=true&w=majority
